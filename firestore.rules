rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedEmail()
        && request.auth.token.email == 'adityo.jayatamactc@gmail.com';
    }

    function isValidTeacherProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() <= 120
        && data.email is string && data.email.size() <= 180
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubjectConfig(data, userId, subjectId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'code', 'name', 'gradeLevel', 'pgCount', 'essayCount',
          'pgWeight', 'essayWeight', 'kkm', 'answerKey', 'essayRubrics', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'code', 'name', 'gradeLevel', 'pgCount', 'essayCount',
          'pgWeight', 'essayWeight', 'kkm', 'answerKey', 'essayRubrics', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == subjectId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.gradeLevel is string && data.gradeLevel.size() <= 120
        && data.pgCount is int && (data.pgCount == 40 || data.pgCount == 45)
        && data.essayCount is int && data.essayCount == 5
        && data.pgWeight is number && data.pgWeight >= 0 && data.pgWeight <= 100
        && data.essayWeight is number && data.essayWeight >= 0 && data.essayWeight <= 100
        && data.kkm is number && data.kkm >= 0 && data.kkm <= 100
        && data.answerKey is list && data.answerKey.size() == data.pgCount && data.answerKey[0] is string
        && data.essayRubrics is list && data.essayRubrics.size() == 5 && data.essayRubrics[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentSubmission(data, userId, submissionId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'subjectId', 'fileName', 'mimeType', 'fileDataUrl',
          'uploadedAt', 'studentName', 'studentId', 'studentClass', 'sheetConditionNote',
          'status', 'mcAnswers', 'essayAnswers', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'subjectId', 'fileName', 'mimeType', 'fileDataUrl',
          'uploadedAt', 'studentName', 'studentId', 'studentClass', 'sheetConditionNote',
          'status', 'verifiedBy', 'verifiedAt', 'mcAnswers', 'essayAnswers', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == submissionId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.subjectId is string && isValidId(data.subjectId)
        && data.fileName is string && data.fileName.size() <= 200
        && data.mimeType is string && data.mimeType.size() <= 80
        && data.fileDataUrl is string && data.fileDataUrl.size() <= 350000
        && data.uploadedAt is string && data.uploadedAt.size() <= 64
        && data.studentName is string && data.studentName.size() <= 150
        && data.studentId is string && data.studentId.size() <= 64
        && data.studentClass is string && data.studentClass.size() <= 64
        && data.sheetConditionNote is string && data.sheetConditionNote.size() <= 500
        && data.status is string && (data.status == 'needs_review' || data.status == 'verified')
        && (!data.keys().hasAny(['verifiedBy']) || (data.verifiedBy is string && data.verifiedBy.size() <= 120))
        && (!data.keys().hasAny(['verifiedAt']) || (data.verifiedAt is string && data.verifiedAt.size() <= 64))
        && data.mcAnswers is list && data.mcAnswers.size() >= 1 && data.mcAnswers.size() <= 45 && data.mcAnswers[0] is map
        && data.essayAnswers is list && data.essayAnswers.size() >= 1 && data.essayAnswers.size() <= 5 && data.essayAnswers[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isVerifiedEmail() && isOwner(userId)
        && isValidTeacherProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerifiedEmail() && isOwner(userId)
        && isValidTeacherProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;

      match /subjects/{subjectId} {
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow get: if isValidId(subjectId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(subjectId) && isVerifiedEmail() && isOwner(userId)
          && isValidSubjectConfig(incoming(), userId, subjectId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(subjectId) && isVerifiedEmail() && isOwner(userId)
          && isValidSubjectConfig(incoming(), userId, subjectId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'name', 'gradeLevel', 'pgCount', 'essayCount',
            'pgWeight', 'essayWeight', 'kkm', 'answerKey', 'essayRubrics', 'updatedAt'
          ]);
        allow delete: if isValidId(subjectId) && isVerifiedEmail() && isOwner(userId);
      }

      match /submissions/{submissionId} {
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow get: if isValidId(submissionId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(submissionId) && isVerifiedEmail() && isOwner(userId)
          && isValidStudentSubmission(incoming(), userId, submissionId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/users/$(userId)/subjects/$(incoming().subjectId));
        allow update: if isValidId(submissionId) && isVerifiedEmail() && isOwner(userId)
          && isValidStudentSubmission(incoming(), userId, submissionId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().subjectId == existing().subjectId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().status == 'needs_review'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'fileDataUrl', 'studentName', 'studentId', 'studentClass',
                'sheetConditionNote', 'status', 'verifiedBy', 'verifiedAt',
                'mcAnswers', 'essayAnswers', 'updatedAt'
              ])
            )
            ||
            (
              existing().status == 'verified'
              && incoming().status == 'needs_review'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'verifiedBy', 'verifiedAt', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(submissionId) && isVerifiedEmail() && isOwner(userId);
      }
    }
  }
}
